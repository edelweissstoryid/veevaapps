# Copy this file to .env.local and add the project values from Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Never expose the Supabase service role key using a NEXT_PUBLIC_ variable.
# Database migrations should be applied with the Supabase CLI or SQL Editor.
